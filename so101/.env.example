# Copy this to .env and fill it in, once on each machine.
# Only fill in the arm that machine has.

ZRT_TOKEN=
ZRT_MEETING_ID=

# Control rate, in Hz.
ZRT_FPS=30

# How fast the arm may move. Lower it to 2.0 to go slowly.
ZRT_SLEW=12.0

# Serial ports. Linux: /dev/ttyACM0. macOS: /dev/cu.usbmodem...
# Run `lerobot-find-port` to see which is which.
ZRT_FOLLOWER_PORT=/dev/ttyACM0
ZRT_LEADER_PORT=/dev/ttyACM1

# Your calibration names from `lerobot-calibrate`.
# Leave blank and the script lists the ones you have.
ZRT_FOLLOWER_ID=
ZRT_LEADER_ID=
