# Studio server configuration. Copy to .env.local and fill in. Never commit real values.
# These are read on the server only; none is exposed to the browser.

# VideoSDK API key of the account that owns the Studio rooms (required).
ZERORUNTIME_API_KEY=
# The matching API secret; signs every token (required).
ZERORUNTIME_SECRET=
# Id of the Zero Runtime voice agent to dispatch into a room (optional). Leave empty until a voice agent is deployed:
# the Voice toggle then shows disabled ("Voice is not available yet") and POST /api/voice answers 503 voice_unavailable.
# Everything else (sessions, keyboard driving, the Python leader) works without it.
STUDIO_VOICE_AGENT_ID=

# API origin for rooms, agent dispatch and the dashboard profile (default https://api.videosdk.live).
ZERORUNTIME_API_BASE=https://api.videosdk.live
# Redis for rate limits, issued rooms and the voice queue. Leave empty for an in-memory store (one process, dev only).
REDIS_URL=
# Session length in seconds; the join token lives 60 s longer (default 300).
STUDIO_SESSION_SECONDS=300
# Voice sessions allowed at once; further visitors are queued (default 5).
STUDIO_VOICE_MAX_CONCURRENT=5
# Sessions one IP may start per hour before a 429 (default 10).
STUDIO_SESSIONS_PER_IP_PER_HOUR=10
# DEPLOYMENT REQUIREMENT: how many reverse proxies in front of Studio append the client address to x-forwarded-for
# (default 1). The per-IP limit trusts only the entry that many places from the end; the proxy must append the
# address it sees (not pass the client's header through unchanged), or the limit can be dodged by forging the header.
STUDIO_TRUSTED_PROXY_HOPS=1
