<!--
  SO-101 tabletop scene for ZeroRuntime Studio: four 3 cm cubes and an open box on a table, in a simple room.

  Adapted from LeRobot EnvHub `lerobot/so101-tabletop-mujoco` (so101_tabletop.xml, Apache-2.0); see NOTICE.
  EnvHub attaches the Menagerie arm at the `so101_mount` site with an empty prefix; here so101.xml is
  <include>d instead, so its base body sits at the world origin (the mount) and joint, actuator, site
  (`gripperframe`) and camera (`wrist_cam`) names are the same unprefixed ones.

  Physics: the arm's own options (implicitfast, elliptic cones, ...) come from so101.xml. The timestep is
  1/210 s: EnvHub runs round(1 / (30 fps * 0.005 s)) = 7 substeps per 30 fps control step and then
  retunes the timestep to 1 / (30 * 7).
  Reset randomization (object poses, front camera jitter, joint noise) lives in src/sim/scene.ts.
-->
<mujoco model="so101_tabletop">
  <include file="so101.xml"/>

  <option timestep="0.004761904761904762"/>

  <!-- The extent of the workspace, not the room: MuJoCo scales the near clipping plane and the shadow
       map with it, and the wrist camera sees the gripper from a few centimeters. -->
  <statistic center="0.2 0 0.1" extent="0.6"/>

  <visual>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.2 0.2 0.2" specular="0 0 0"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <custom>
    <text name="instruction" data="Put all the cubes in the green box."/>
  </custom>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.75 0.75" rgb2="0.45 0.45 0.45" width="512" height="3072"/>
    <material name="table" rgba="0.80 0.72 0.60 1" specular="0.05" shininess="0.1"/>
    <!-- Painted wooden cubes: one light wood grain, tinted by each cube's material. -->
    <texture name="wood" type="cube" file="textures/wood.png"/>
    <material name="red_wood" texture="wood" rgba="0.95 0.15 0.12 1" specular="0.2" shininess="0.3"/>
    <material name="green_wood" texture="wood" rgba="0.20 0.75 0.25 1" specular="0.2" shininess="0.3"/>
    <material name="blue_wood" texture="wood" rgba="0.15 0.35 0.95 1" specular="0.2" shininess="0.3"/>
    <material name="yellow_wood" texture="wood" rgba="1.0 0.85 0.12 1" specular="0.2" shininess="0.3"/>
    <material name="table_leg" rgba="0.30 0.25 0.20 1"/>
    <material name="floor" rgba="0.38 0.37 0.36 1"/>
    <material name="wall" rgba="0.85 0.84 0.80 1" emission="0.5"/>
    <material name="box" rgba="0.22 0.60 0.33 1" specular="0.6" shininess="0.7" reflectance="0.05"/>
  </asset>

  <default>
    <default class="cube">
      <geom type="box" size="0.015 0.015 0.015" mass="0.01" condim="4" friction="1 0.03 0.003" solref="0.01 1"/>
    </default>
    <default class="box_wall">
      <geom type="box" material="box"/>
    </default>
    <!-- Room and table legs: visual only. -->
    <default class="decor">
      <geom type="box" contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <light pos="0.3 -0.4 0.8" dir="-0.3 0.5 -1" diffuse="0.25 0.25 0.25" castshadow="true"/>
    <!-- Table: an 80 x 80 cm top, its surface at z = 0, on 75 cm legs. -->
    <geom name="table" type="box" size="0.40 0.40 0.015" pos="0.20 0 -0.015" material="table"/>
    <geom class="decor" size="0.02 0.02 0.36" pos="0.56 0.36 -0.39" material="table_leg"/>
    <geom class="decor" size="0.02 0.02 0.36" pos="0.56 -0.36 -0.39" material="table_leg"/>
    <geom class="decor" size="0.02 0.02 0.36" pos="-0.16 0.36 -0.39" material="table_leg"/>
    <geom class="decor" size="0.02 0.02 0.36" pos="-0.16 -0.36 -0.39" material="table_leg"/>

    <!-- Room: a floor and three 2 m walls around the table. -->
    <geom name="floor" type="plane" size="1.0 1.5 0.05" pos="0 0 -0.75" material="floor"/>
    <geom class="decor" size="0.02 1.5 1.0" pos="-1.0 0 0.25" material="wall"/>
    <geom class="decor" size="1.0 0.02 1.0" pos="0 1.5 0.25" material="wall"/>
    <geom class="decor" size="1.0 0.02 1.0" pos="0 -1.5 0.25" material="wall"/>

    <body name="red_cube" pos="0.23 0 0.015">
      <freejoint/>
      <geom class="cube" material="red_wood"/>
    </body>
    <body name="green_cube" pos="0.23 0 0.015">
      <freejoint/>
      <geom class="cube" material="green_wood"/>
    </body>
    <body name="blue_cube" pos="0.23 0 0.015">
      <freejoint/>
      <geom class="cube" material="blue_wood"/>
    </body>
    <body name="yellow_cube" pos="0.23 0 0.015">
      <freejoint/>
      <geom class="cube" material="yellow_wood"/>
    </body>

    <!-- Open box: 9 cm inside, 3.5 cm walls. Static, so randomization moves the body itself. -->
    <body name="box" pos="0.22 0.125 0">
      <geom class="box_wall" size="0.049 0.049 0.002" pos="0 0 0.002"/>
      <geom class="box_wall" size="0.002 0.049 0.0175" pos="0.047 0 0.0175"/>
      <geom class="box_wall" size="0.002 0.049 0.0175" pos="-0.047 0 0.0175"/>
      <geom class="box_wall" size="0.049 0.002 0.0175" pos="0 0.047 0.0175"/>
      <geom class="box_wall" size="0.049 0.002 0.0175" pos="0 -0.047 0.0175"/>
    </body>

    <camera name="front" pos="0.5 0 0.2" xyaxes="0 1 0 -0.493 0 0.87" fovy="60"/>
    <camera name="top" pos="0.2 0 0.48" xyaxes="0 -1 0 1 0 0" fovy="60"/>
  </worldbody>
</mujoco>
