<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_teleop_bringup</name>
  <version>0.0.0</version>
  <description>Two SO-101 arms on ros2_control, leader and follower, with the zeroruntime-teleops bridge between them: launch files, URDF, controller and bridge configs.</description>
  <!-- TODO: a real maintainer email; this placeholder only satisfies the format. -->
  <maintainer email="todo@todo.todo">ZeroRuntime</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The bridge (zrt-teleops-ros2-*) is pip-installed, not a rosdep: see README.md. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>feetech_ros2_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
