# Copy this to .env and fill it in, once on each machine.
# Only fill in the arm that machine has.

# The SDK's own names: the ROS node reads these itself.
ZERORUNTIME_AUTH_TOKEN=
ZERORUNTIME_MEETING_ID=

# Serial ports. A /dev/serial/by-id/... path survives replugs; ttyACM0 may not.
ZERORUNTIME_LEADER_PORT=/dev/ttyACM0
ZERORUNTIME_FOLLOWER_PORT=/dev/ttyACM0

# Your calibration names from `lerobot-calibrate`.
ZERORUNTIME_LEADER_ID=
ZERORUNTIME_FOLLOWER_ID=

# Follower only: which cameras to stream, comma-separated, or "none".
# Default: every USB camera (every camera on macOS). To list them, venv active:
#   python -m zeroruntime.teleops.devices
# and copy the right-hand names under "cameras". On macOS the names are
# numbers (0, 1, ...) and opencv-python must be installed.
# ZERORUNTIME_CAMERAS=platform-...-video-index0,platform-...-video-index0
