# Copy this to .env and fill it in.

# The same token and room as so101/.env. One token drives the room and the
# voice agent.
ZERORUNTIME_AUTH_TOKEN=
ZERORUNTIME_MEETING_ID=

# Optional: your Zero Runtime address. Blank means us2.zeroruntime.ai.
ZERORUNTIME_TARGET=

# Control rate, in Hz. Match so101/.env.
ZERORUNTIME_FPS=30

# Where agent.py serves the page.
ZERORUNTIME_WEB_PORT=8000

# hi (default): Deepgram Hindi + Sarvam voice -- also understands English and
# Hinglish, answers in your language. en: Deepgram + Cartesia.
ZERORUNTIME_LANGUAGE=hi

# 1 loads MolmoAct2 for pick_up / place (21.8 GB download, ~14 GB memory).
ZERORUNTIME_PICKUP=0

# Where the follower runs, for demo.sh. Unset: this machine (../so101).
# ROBOT_HOST=jetson-remote
# ROBOT_DIR=~/voice-demo/so101
# ROBOT_PYTHON=~/zrt-teleops-examples/venv/bin/python
