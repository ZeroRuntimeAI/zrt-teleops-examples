# Copy this to .env and fill it in, once on each machine.

ZERORUNTIME_AUTH_TOKEN=
ZERORUNTIME_MEETING_ID=

# Control rate, in Hz.
ZERORUNTIME_FPS=30

# On the robot machine
# ────────────────────
# Serial port. Linux: /dev/ttyACM0. macOS: /dev/cu.usbmodem...
ZERORUNTIME_FOLLOWER_PORT=/dev/ttyACM0

# Your calibration name from `lerobot-calibrate`.
ZERORUNTIME_FOLLOWER_ID=

# On the machine running the model
# ────────────────────────────────
# Folder holding config.json and model.safetensors.
ZERORUNTIME_POLICY_PATH=

# What the policy was trained to do, word for word.
ZERORUNTIME_TASK=
